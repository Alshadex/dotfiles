// -*- mode: jsonc -*-
{
    "position": "top",
    "height": 40,
    "margin-top": 8,
    "margin-left": 16,
    "margin-right": 16,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "custom/notification",
        "custom/darkmode",
        "network",
        "cpu",
        "memory",
        "pulseaudio"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active":  "●",
            "default": "●",
            "empty":   "○",
            "urgent":  "●"
        },
        "on-click": "activate",
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": 5
        }
    },

    "clock": {
        "format": "{:%a %d %b   %H:%M}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='#cba6f7'><b>{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "days":     "<span color='#cdd6f4'>{}</span>",
                "today":    "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        }
    },

    "network": {
        "format-wifi":       "󰤨 {signalStrength}%",
        "format-ethernet":   "󰈀 {ipaddr}",
        "format-disconnected": "󰤭",
        "format-linked":     "󰈀 (no IP)",
        "tooltip-format-wifi": "{essid}\n{ifname}  {ipaddr}\nSignal: {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}  {ipaddr}",
        "on-click": "nm-connection-editor"
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰾆 {percentage}%",
        "interval": 2,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format":        "{icon} {volume}%",
        "format-muted":  "󰖁",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"],
            "headphone": "󰋋",
            "headset": "󰋎"
        },
        "scroll-step": 5,
        "on-click": "pavucontrol",
        "tooltip-format": "{desc} — {volume}%"
    },

    "custom/notification": {
        "exec": "swaync-client --subscribe-waybar",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "none":             "󰂚",
            "notification":     "󰂚",
            "dnd":              "󰂛",
            "dnd-notification": "󰂛"
        },
        "on-click": "swaync-client --toggle-panel --skip-wait",
        "on-click-right": "swaync-client --close-all --skip-wait",
        "escape": true
    },

    "custom/darkmode": {
        "exec": "gsettings get org.gnome.desktop.interface color-scheme | grep -q prefer-dark && echo '{\"text\":\"󰖔\",\"tooltip\":\"Dark mode — click to switch\",\"class\":\"dark\"}' || echo '{\"text\":\"󰖙\",\"tooltip\":\"Light mode — click to switch\",\"class\":\"light\"}'",
        "return-type": "json",
        "on-click": "~/.local/bin/toggle-dark-mode",
        "signal": 8,
        "interval": "once"
    }
}
